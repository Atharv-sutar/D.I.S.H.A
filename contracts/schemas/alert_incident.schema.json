{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Atharv-sutar/D.I.S.H.A./contracts/schemas/alert_incident.schema.json",
  "title": "AlertIncident",
  "description": "Operational alert or emerging incident with optional 3D hologram beacon position.",
  "type": "object",
  "required": [
    "incident_id",
    "venue_id",
    "created_at",
    "category",
    "severity",
    "status",
    "node_id",
    "title",
    "description",
    "recommended_action"
  ],
  "properties": {
    "incident_id": { "type": "string" },
    "venue_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "category": {
      "type": "string",
      "enum": ["queue_surge", "crowd_bottleneck", "medical", "security", "facility_fault"]
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "status": {
      "type": "string",
      "enum": ["open", "acknowledged", "dispatched", "resolved"]
    },
    "node_id": { "type": "string" },
    "position": {
      "type": "object",
      "description": "3D coordinates for holographic incident beacon placement.",
      "required": ["x", "y", "z", "level"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "level": { "type": "integer" }
      }
    },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "recommended_action": { "type": "string" },
    "assigned_team": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
